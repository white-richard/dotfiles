// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  // Extensions are otherwise untracked by this repo; list them so a fresh
  // machine ends up with the same language + formatter support.
  "auto_install_extensions": {
    "csv": true,
    "dockerfile": true,
    "fish": true,
    "git-firefly": true,
    "harper": true,
    "html": true,
    "latex": true,
    "log": true,
    "ltex": true,
    "lua": true,
    "make": true,
    "markdown-oxide": true,
    "rainbow-csv": true,
    "svelte": true,
    "terraform": true,
    "texpresso": true,
    "toml": true,
    "typst": true,
    "zig": true,
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "prettier": {
    "allowed": true,
  },
  "gutter": {
    "breakpoints": true,
  },
  "edit_predictions": {
    "provider": "copilot",
    "mode": "subtle",
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "write",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "oswe-vscode-prime",
    },
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "gpt-5.4-mini",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "ssh_connections": [
    {
      "host": "wpeb-server",
      "args": [],
      "projects": []
    },
    {
      "host": "home",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/richw/.code/archive/pasta/./"
          ]
        },
        {
          "paths": [
            "/home/richw/.code/nyx_lang/./"
          ]
        },
        {
          "paths": [
            "/home/richw/.code/open-penny/./"
          ]
        }
      ]
    },
    {
      "host": "wpeb-print",
      "args": [],
      "projects": []
    },
    {
      "host": "wpeb-mary",
      "args": [],
      "projects": []
    },
    {
      "host": "wpeb-desk",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/richw/.code/conf-wall"
          ]
        },
        {
          "paths": [
            "/home/richw/.code/mammoclip/./"
          ]
        },
        {
          "paths": [
            "/home/richw/.code/nut-ups-cutoff"
          ]
        }
      ]
    },
    {
      "host": "ankita",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/richw/.code/genesis-agent/./"
          ]
        },
        {
          "paths": [
            "/home/richw/.code/mammogram-fm-benchmark/./"
          ]
        },
        {
          "paths": [
            "/home/richw/.code/tta-mammo/./"
          ]
        }
      ]
    }
  ],
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "never",
  },
  "terminal": {
    "copy_on_select": false,
    "shell": {
      "program": "/opt/homebrew/bin/fish",
    },
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "never",
  },
  // NOTE: no `autosave`. Zed's autosave saves *without* running `format_on_save`
  // (zed-industries/zed#16588, #27469, #30077), so an autosave timer means the
  // buffer is almost always already saved before a format ever runs. Saving
  // explicitly keeps Zed's behaviour identical to nvim's BufWritePre hook.
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 16,
  "buffer_font_size": 11.0,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
  // Scroll Bar Related Settings
  "scrollbar": {
    // When to show the scrollbar in the editor (auto, system, always, never)
    "show": "auto",
    "cursors": true, // Show cursor positions in the scrollbar.
    "git_diff": true, // Show git diff indicators in the scrollbar.
    "search_results": true, // Show buffer search results in the scrollbar.
    "selected_text": true, // Show selected text occurrences in the scrollbar.
    "selected_symbol": true, // Show selected symbol occurrences in the scrollbar.
    "diagnostics": "all", // Show diagnostics (none, error, warning, information, all)
    "axes": {
      "horizontal": true, // Show/hide the horizontal scrollbar
      "vertical": true, // Show/hide the vertical scrollbar
    },
  },
  "enable_language_server": true,
  "format_on_save": "on",
  "languages": {
    // "LaTeX": {
    //   "format_on_save": "on",
    //   "formatter": {
    //     "external": {
    //       "command": "latexindent",
    //       "arguments": [
    //         "-m",
    //         "-y",
    //         "modifyLineBreaks:oneSentencePerLine:manipulateSentences:1",
    //         "-c",
    //         "build",
    //         "{buffer_path}",
    //       ],
    //     },
    //   },
    // },
    "LaTeX": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "tex-fmt",
          "arguments": ["--stdin"],
        },
      },
      "language_servers": ["texpresso-lsp", "texlab", "..."],
    },
    "Markdown": {
      "show_edit_predictions": false,
    },
    // The entries below exist to match nvim's none-ls formatters exactly.
    // Same binary, same arguments, same config file discovery.
    "Lua": {
      // lua-language-server advertises documentFormattingProvider and
      // `Lua.format.enable` defaults to true, so leaving `formatter` unset
      // would silently format with EmmyLuaCodeStyle instead of stylua.
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": ["--search-parent-directories", "--stdin-filepath", "{buffer_path}", "-"],
        },
      },
    },
    "Shell Script": {
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["-i", "4"],
        },
      },
    },
    "Terraform": {
      "formatter": {
        "external": {
          "command": "terraform",
          "arguments": ["fmt", "-"],
        },
      },
    },
    "Dockerfile": {
      // nvim does not format Dockerfiles; keep docker-language-server from
      // doing it here.
      "format_on_save": "off",
    },
    "TOML": {
      "formatter": "language_server",
      "format_on_save": "off",
    },
    "Python": {
      "show_edit_predictions": true,
      "language_servers": ["ruff", "!basedpyright", "pylsp"],
      // Scoped to Python: nvim only runs these as part of its ruff chain.
      // Globally, this also fired eslint's source.fixAll on JS/TS, which nvim
      // has no equivalent for.
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll": true,
      },
    },
    "Typst": {
      "formatter": "language_server",
    },
  },
  "lsp": {
    "harper-ls": {
      "settings": {
        "harper-ls": {
          // Use a specific English dialect
          "dialect": "American",
          "linters": {
            // Disable specific rules
            // For rule names consult tooltips and https://writewithharper.com/docs/rules
          },
        },
      },
    },
    "ltex": {
      "settings": {
        "ltex": {
          "language": "en-US",
          "disabledRules": {
            "en-US": ["MORFOLOGIK_RULE_EN_US"],
          },
        },
      },
    },
    "texlab": {
      "settings": {
        "texlab": {
          "latexindent": { "modifyLineBreaks": true },
          "build": {
            "onSave": true,
            "executable": "latexmk",
            "args": ["-pdf", "-outdir=build"],
          },
          "chktex": {
            "onOpenAndSave": false,
            "onEdit": false,
          },
        },
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "configuration": "~/.config/ruff/ruff.toml",
          "configurationPreference": "filesystemFirst",
        },
      },
    },
    // "tinymist": {
    //   "settings": {
    //     "exportPdf": "onSave",
    //     "outputPath": "$root/$name",
    //   },
    // },
    "tinymist": {
      "initialization_options": {
        "preview": {
          "background": {
            "enabled": true,
            "args": [
              "--data-plane-host=127.0.0.1:23635",
              // "--invert-colors=auto",
              "--open",
            ],
          },
        },
      },
      "settings": {
        "formatterMode": "typstyle",
      },
    },
    "texpresso-lsp": {
      "initialization_options": {
        "root_tex": "main.tex",
      },
      "settings": {
        "preview_follow_cursor": true,
      },
    },
  },
  // Blurred background
  // "experimental.theme_overrides": {
  //   "background.appearance": "blurred",
  //   "background": "#00000070",
  //   "panel.background": "#00000030",
  //   "editor.background": "#00000020",
  //   "status_bar.background": "#00000090"
  // },
  "relative_line_numbers": "enabled",
  "scroll_sensitivity": 1.0, // Scroll sensitivity multiplier
  // Scroll sensitivity multiplier for fast scrolling (hold alt while scrolling)
  "fast_scroll_sensitivity": 4.0,
  "cursor_blink": false,
  "vertical_scroll_margin": 12,
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "code_actions": false,
    "breadcrumbs": true, // Scroll sensitivity multiplier
    "quick_actions": true, // Whether to show quick action buttons
  },
  // Status bar related settings
  "status_bar": {
    // Show/hide a button that displays the active buffer's language.
    // Clicking the button brings up the language selector.
    "active_language_button": false,
    // Show/hide a button that displays the cursor's position.
    // Clicking the button brings up an input for jumping to a line and column.
    "cursor_position_button": true,
    // Show/hide a button that displays the buffer's line-ending mode.
    // Clicking the button brings up the line-ending selector.
    "line_endings_button": false,
    // Show/hide a button that displays the buffer's character encoding.
    // If set to "non_utf8", the button is hidden only for UTF-8 without BOM.
    "active_encoding_button": "non_utf8",
  },
  "global_lsp_settings": {
    // Show/hide the LSP button in the status bar.
    // Activity from the LSP is still shown.
    // Button is not shown if "enable_language_server" if false.
    "button": true,
  },
  "use_system_path_prompts": false,
}
