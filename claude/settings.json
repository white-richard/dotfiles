{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)",
      "Bash(git push *)"
    ],
    "ask": [
      "Read(./.env.*)",
      "Bash(git commit *)",
      "Bash(dangerouslyDisableSandbox:true)"
    ],
    "defaultMode": "auto"
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 175000,
  "theme": "light-daltonized",
  "editorMode": "vim",
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(uv lock:*)"
    ]
  }
}
